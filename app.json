{
  "expo": {
    "name": "bicloset",
    "slug": "bicloset",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bicloset",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F1F1F1",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "O bicloset usa a câmera para fotografar as peças do seu guarda-roupa.",
        "NSPhotoLibraryUsageDescription": "O bicloset usa suas fotos para cadastrar peças e a imagem de referência da prova virtual."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F1F1F1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F1F1F1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O bicloset usa suas fotos para cadastrar peças e a imagem de referência da prova virtual.",
          "cameraPermission": "O bicloset usa a câmera para fotografar as peças do seu guarda-roupa."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8a65535f-f740-48b0-a1d5-ebdbebbb742e"
      }
    },
    "owner": "ref_1012",
    "runtimeVersion": "exposdk:57.0.0",
    "updates": {
      "url": "https://u.expo.dev/8a65535f-f740-48b0-a1d5-ebdbebbb742e"
    }
  }
}
