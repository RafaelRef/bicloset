# Copie para .env e preencha. O .env fica fora do git.
# Depois de criar ou alterar o .env, reinicie o servidor: as variaveis
# EXPO_PUBLIC_* sao embutidas no bundle na hora do build.

# Remocao de fundo das fotos de peca — https://www.remove.bg/api
# Plano gratis: 50 fotos por mes. A chave fica em "API Key" no painel.
EXPO_PUBLIC_REMOVE_BG_KEY=

# Opcional. "preview" (padrao) gasta 1 credito e basta para o app.
# "auto" devolve alta resolucao e consome mais creditos.
EXPO_PUBLIC_REMOVE_BG_SIZE=preview
